# BasicRoleFlow

main: kit: flow: BasicRoleFlow:
{
  entity: "role",
  kind: "basic",
  name: "BasicRoleFlow",
  step: [
    {
      i: {
        ref: "role_ref01"
      }

      m: {
        client_id: "client01",
        realm: "realm01"
      }

      o: "create"
    }

    {
      m: {
        realm: "realm01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "role_ref01"
          }
        }
      ]
    }

    {
      d: {
        realm: "realm01"
      }

      i: {
        ref: "role_ref01",
        srcdatavar: "role_ref01_data",
        suffix: "_up0",
        textfield: "containerId"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-role_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "role_ref01",
        srcdatavar: "role_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "role01",
        realm: "realm01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-role_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "role_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "role01",
        realm: "realm01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        realm: "realm01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "role_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRoleFlow"
}