# BasicAvailableFlow

main: kit: flow: BasicAvailableFlow:
{
  entity: "available",
  kind: "basic",
  name: "BasicAvailableFlow",
  step: [
    {
      m: {
        realm: "realm01",
        user_id: "user01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "available_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAvailableFlow"
}