# BasicProtocolFlow

main: kit: flow: BasicProtocolFlow:
{
  entity: "protocol",
  kind: "basic",
  name: "BasicProtocolFlow",
  step: [
    {
      i: {
        ref: "protocol_ref01",
        srcdatavar: "protocol_ref01_data",
        suffix: "_dt0"
      }

      m: {
        client_template_id: "client_template01",
        id: "protocol01",
        realm: "realm01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-protocol_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProtocolFlow"
}