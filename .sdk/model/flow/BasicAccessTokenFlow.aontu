# BasicAccessTokenFlow

main: kit: flow: BasicAccessTokenFlow:
{
  entity: "access_token",
  kind: "basic",
  name: "BasicAccessTokenFlow",
  step: [
    {
      m: {
        client_id: "client01",
        realm: "realm01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "access_token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccessTokenFlow"
}