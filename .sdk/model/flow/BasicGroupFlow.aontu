# BasicGroupFlow

main: kit: flow: BasicGroupFlow:
{
  entity: "group",
  kind: "basic",
  name: "BasicGroupFlow",
  step: [
    {
      i: {
        ref: "group_ref01"
      }

      m: {
        client_id: "client01",
        realm: "realm01",
        role_name: "role_name01",
        user_id: "user01"
      }

      o: "create"
    }

    {
      m: {
        realm: "realm01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "group_ref01"
          }
        }
      ]
    }

    {
      d: {
        realm: "realm01"
      }

      i: {
        ref: "group_ref01",
        srcdatavar: "group_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "group_ref01",
        srcdatavar: "group_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "group01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "group_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "group01",
        realm: "realm01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        realm: "realm01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "group_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGroupFlow"
}